# Copy to .env.local and fill in real values.
# .env.local is loaded by docker-compose into the web container.

# Postgres (service hostname "db" resolves inside the compose network)
DATABASE_URL=postgresql://postgres:postgres@db:5432/emailintel

# Klaviyo private API key — pk_... Server-only. Never expose to the browser.
KLAVIYO_API_KEY=pk_REPLACE_ME

# Random secret required in the x-sync-token header to trigger POST /api/sync.
SYNC_TOKEN=replace_with_a_long_random_string

# Auth.js session signing key. Generate with `openssl rand -base64 32`.
AUTH_SECRET=replace_with_32_byte_random_base64
# Auth.js needs to know where it's running so callback URLs resolve.
AUTH_URL=http://localhost:3000

# First admin bootstrapped on container start. Skipped if a user with this email already exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_on_first_login
