# Production env file for the VPS. Copy to `.env.production` on the server and fill in real values.
# DO NOT commit `.env.production` (it's gitignored).
#
# Generate strong secrets:
#   openssl rand -base64 32   # AUTH_SECRET
#   openssl rand -hex 24      # SYNC_TOKEN
#   openssl rand -hex 24      # POSTGRES_PASSWORD

# --- Database ---
POSTGRES_PASSWORD=replace_with_random_hex
DATABASE_URL=postgresql://postgres:replace_with_random_hex@db:5432/inboxatlas

# --- Klaviyo ---
# Private API key (pk_...). Same as dev unless you're using a separate workspace.
KLAVIYO_API_KEY=pk_REPLACE_ME

# --- Sync route guard ---
# Required in `x-sync-token` header for POST /api/sync. The internal cron uses this too.
SYNC_TOKEN=replace_with_random_hex

# --- Auth.js ---
AUTH_SECRET=replace_with_base64_32
AUTH_URL=https://inbox-atlas.particle-retention.cloud
# Auth.js v5 honors X-Forwarded-* from the reverse proxy; set this to keep callbacks on https.
AUTH_TRUST_HOST=true

# --- First admin bootstrap (used once on first boot, ignored after) ---
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=set_a_strong_temporary_password
